{
	"image": "ghcr.io/doughom/devcontainer:latest@sha256:fdbea514b71b2983cfe800f1a3444858beccddb937a94fa8ebfdb81a2e723b69",
	"postCreateCommand": "sudo chown -R vscode:vscode /workspaces/; npm install",
